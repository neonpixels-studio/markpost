# Neon DB — https://console.neon.tech → your project → Connection Details
# The app uses the pooled connection string (DATABASE_URL). Drizzle migrations
# need a DIRECT connection, since pooled PgBouncer connections break DDL: copy
# the string with Neon's "Pooled connection" toggle off into
# DATABASE_URL_UNPOOLED (host without `-pooler`), which drizzle.config prefers.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require
NUXT_DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Clerk — https://dashboard.clerk.com → API Keys
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NUXT_CLERK_SECRET_KEY=sk_test_...

# Clerk webhook signing secret — https://dashboard.clerk.com → Configure → Webhooks
# → your endpoint → Signing Secret. Verifies the Svix signature on inbound Clerk
# webhooks so /api/webhooks/clerk can reconcile out-of-band `user.deleted` events
# (cancel Stripe billing + cascade-delete app data) just like the in-app delete.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Disable new user sign-ups (optional). When "true", existing users keep working
# but a newly-authenticated Clerk identity is rejected with a 403 instead of being
# registered. Read via runtimeConfig, so it bakes into the build — set it only in
# the environment you want it in. Leave empty to allow sign-ups (the local default).
NUXT_DISABLE_SIGNUPS=

# Public base URL of the app — used to build absolute redirect URLs for Stripe Checkout and Customer Portal.
# Example: https://yourapp.netlify.app for production; http://localhost:3000 for local dev.
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — https://dashboard.stripe.com → Developers → API Keys
# Secret key (server-only). Used by the billing API to create Checkout and Customer Portal sessions.
# A standard secret key suffices; a restricted key needs customers read plus subscriptions read/write
# (account deletion reads the customer to prove the key can see it before treating a sweep as complete).
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret — https://dashboard.stripe.com → Developers → Webhooks → your endpoint → Signing secret
# Used to verify both inbound source webhooks (Stripe provider) and the billing lifecycle webhook.
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe price IDs — https://dashboard.stripe.com → Products → your Pro plan → Pricing
# STRIPE_PRO_PRICE_ID: monthly Pro plan price ID (required for Checkout with priceKey=pro)
# STRIPE_PRO_ANNUAL_PRICE_ID: annual Pro plan price ID (required for Checkout with priceKey=pro_annual)
STRIPE_PRO_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...

# Sentry — https://sentry.io → Settings → Projects → Client Keys (DSN)
NUXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=danholloran
SENTRY_PROJECT=markpost

# Neon branch API — .env.e2e ONLY (not read by the app)
# The CI e2e job creates a fresh Neon branch per run and deletes it after, using
# these two values pulled from .env.e2e via `dotenvx get`. Keeping them in the
# encrypted file means CI needs only DOTENV_PRIVATE_KEY_E2E, no extra secrets.
#   NEON_API_KEY    — https://console.neon.tech → Account settings → API keys
#   NEON_PROJECT_ID — https://console.neon.tech → Project → Settings → General
NEON_API_KEY=
NEON_PROJECT_ID=
