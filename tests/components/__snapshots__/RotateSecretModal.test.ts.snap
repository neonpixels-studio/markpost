// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RotateSecretModal > matches snapshot for the confirm step (github) 1`] = `
"<div style="position: fixed; inset: 0; display: grid; place-items: center; z-index: 60; padding: 24px;">
  <div class="card" style="width: 480px; max-width: 100%; max-height: 90%; overflow: auto; box-shadow: var(--sh-pop);">
    <!-- head -->
    <div class="row between" style="padding: 18px 24px; border-bottom-width: var(--line); border-bottom-style: var(--line); border-bottom-color: var(--line);">
      <div class="col" style="gap: 2px;"><span class="mono faint" style="font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;">GitHub</span>
        <h3 style="font-size: 17px; font-weight: 600;">Rotate secret</h3>
      </div><button class="icon-btn"><svg class="ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg></button>
    </div><!-- step: confirm -->
    <div style="padding: 24px;">
      <!--v-if-->
      <div class="alert warn" role="alert"><svg class="ico a-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
          <line x1="12" y1="9" x2="12" y2="13"></line>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
        <div class="a-body">
          <div class="a-title">This replaces the current secret</div>
          <div class="a-text"> Rotating generates a brand-new secret and takes effect immediately. Deliveries verified with the old secret will be rejected until the new one is in place. </div>
        </div>
        <!--v-if-->
      </div>
      <!--v-if-->
      <div class="row gap-3" style="justify-content: flex-end; margin-top: 22px;"><button class="btn btn-ghost">
          <!--v-if-->cancel
          <!--v-if-->
        </button><button class="btn btn-accent"><svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
            <path d="M3 3v5h5"></path>
            <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
            <path d="M21 21v-5h-5"></path>
          </svg>rotate secret
          <!--v-if-->
        </button></div>
    </div><!-- step: reveal (generated-secret providers — shown once, right after rotation) -->
    <!--v-if-->
    <!-- step: done (manual-secret providers — nothing new to reveal) -->
    <!--v-if-->
  </div>
</div>"
`;

exports[`RotateSecretModal > matches snapshot for the reveal step (github) 1`] = `
"<div style="position: fixed; inset: 0; display: grid; place-items: center; z-index: 60; padding: 24px;">
  <div class="card" style="width: 480px; max-width: 100%; max-height: 90%; overflow: auto; box-shadow: var(--sh-pop);">
    <!-- head -->
    <div class="row between" style="padding: 18px 24px; border-bottom-width: var(--line); border-bottom-style: var(--line); border-bottom-color: var(--line);">
      <div class="col" style="gap: 2px;"><span class="mono faint" style="font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;">GitHub</span>
        <h3 style="font-size: 17px; font-weight: 600;">New secret</h3>
      </div>
      <!--v-if-->
    </div><!-- step: confirm -->
    <!--v-if-->
    <!-- step: reveal (generated-secret providers — shown once, right after rotation) -->
    <div style="padding: 24px;">
      <div class="alert ok" role="alert"><svg class="ico a-ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21.8 10A10 10 0 1 1 17 3.34"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <div class="a-body">
          <div class="a-title">Secret rotated</div>
          <div class="a-text"> A new secret is live. Copy it now — for your security it will not be shown again. </div>
        </div>
        <!--v-if-->
      </div>
      <div style="margin-top: 16px;">
        <div>
          <div class="code">
            <div class="code-head"><span class="lang">webhook secret</span><button class="icon-btn mono" style="font-size: 11px; gap: 5px; display: inline-flex; align-items: center; color: var(--ink-3);"><svg class="ico" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg> copy secret</button></div>
            <div class="code-body mono" style="font-size: 12.5px; word-break: break-all;">fresh-generated-secret</div>
          </div>
          <div class="muted" style="font-size: 11px; margin-top: 8px;">Paste this into the GitHub repo's Settings -&gt; Webhooks -&gt; Secret field.</div>
        </div>
      </div>
      <div class="row gap-3" style="justify-content: flex-end; margin-top: 22px;"><button class="btn btn-accent"><svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>done
          <!--v-if-->
        </button></div>
    </div><!-- step: done (manual-secret providers — nothing new to reveal) -->
    <!--v-if-->
  </div>
</div>"
`;
