          <!--v-if-->
          <!--v-if--></span><input class="input mono" style="font-size: 13.5px;" placeholder="e.g. title"><span class="field-msg"><!--v-if--><!--v-if--> Dot path to the record title, e.g. data.subject</span>
        </div>
        <div class="field"><span class="field-label"><!--v-if--><span>Content</span>
          <!--v-if-->
          <!--v-if--></span><input class="input mono" style="font-size: 13.5px;" placeholder="e.g. content"><span class="field-msg"><!--v-if--><!--v-if--> Dot path to the markdown/plain-text body</span>
        </div>
        <div class="field"><span class="field-label"><!--v-if--><span>HTML</span>
          <!--v-if-->
          <!--v-if--></span><input class="input mono" style="font-size: 13.5px;" placeholder="e.g. html"><span class="field-msg"><!--v-if--><!--v-if--> Dot path to an HTML body — converted to markdown</span>
        </div>
        <div class="field"><span class="field-label"><!--v-if--><span>Source</span>
          <!--v-if-->
          <!--v-if--></span><input class="input mono" style="font-size: 13.5px;" placeholder="e.g. source"><span class="field-msg"><!--v-if--><!--v-if--> Dot path to override the source name shown on the record</span>
        </div>
        <div class="field"><span class="field-label"><!--v-if--><span>Tags</span>
          <!--v-if-->
          <!--v-if--></span><input class="input mono" style="font-size: 13.5px;" placeholder="e.g. tags"><span class="field-msg"><!--v-if--><!--v-if--> Dot path to a tags array, or a comma-separated string</span>
        </div>
        <div class="field"><span class="field-label"><!--v-if--><span>Created</span>
          <!--v-if-->
          <!--v-if--></span><input class="input mono" style="font-size: 13.5px;" placeholder="e.g. created"><span class="field-msg"><!--v-if--><!--v-if--> Dot path to an ISO timestamp</span>
