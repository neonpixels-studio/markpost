// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RecordBulkActions > matches snapshot 1`] = `
"<div class="card row between wrap gap-3" style="padding: 10px 14px; margin-bottom: 14px;"><span class="mono" style="font-size: 12px; color: var(--ink-2);">2 selected</span>
  <div class="row wrap gap-2"><button class="btn btn-sm">
      <!--v-if-->mark synced
      <!--v-if-->
    </button><button class="btn btn-sm">
      <!--v-if-->mark pending
      <!--v-if-->
    </button><button class="btn btn-sm">
      <!--v-if-->mark error
      <!--v-if-->
    </button><button class="btn btn-ghost btn-sm">
      <!--v-if-->delete selected
      <!--v-if-->
    </button><button class="btn btn-ghost btn-sm">
      <!--v-if-->clear
      <!--v-if-->
    </button></div>
</div>"
`;
