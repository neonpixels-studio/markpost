// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`docs page > matches snapshot in default state 1`] = `
"<div style="height: 100vh; display: flex; flex-direction: column; background: var(--bg);">
  <!-- top nav -->
  <header class="row between" style="height: 56px; padding: 0px 24px; backdrop-filter: blur(8px); border-bottom-width: var(--line); border-bottom-style: var(--line); border-bottom-color: var(--line); flex-grow: 0; flex-shrink: 0; flex-basis: auto;">
    <div class="row gap-4"><a>
        <applogo size="20"></applogo>
      </a>
      <appbadge tone="accent" style="font-size: 10px;">docs</appbadge>
    </div>
    <div class="row gap-3">
      <div class="input-wrap"><span class="lead-addon"><span name="search" size="14"></span></span><input class="input has-lead" placeholder="search docs…" style="height: 34px; width: 200px; font-size: 13px;"><span class="addon"><kbd>/</kbd></span></div><a class="icon-btn" href="https://github.com/neonpixels-studio/markpost" style="color: var(--ink-2);"><span name="github" size="18"></span></a><button class="icon-btn" style="color: var(--ink-2);"><span name="moon" size="17"></span></button>
      <appbtn size="sm" variant="accent" href="/inbox">dashboard</appbtn>
    </div>
  </header>
  <div style="display: grid; grid-template-columns: 248px 1fr 200px; min-height: 0; flex-grow: 1; flex-shrink: 1; flex-basis: 0%;">
    <!-- left sidebar -->
    <nav class="scroll" style="padding: 26px 18px; overflow-y: auto; border-right-width: var(--line); border-right-style: var(--line); border-right-color: var(--line);">
      <!--v-if-->
      <div style="margin-bottom: 22px;"><span class="kicker" style="display: block; padding: 0px 10px 8px;">Introduction</span>
        <ul class="col gap-1" style="list-style: none; padding: 0px; margin: 0px;">
          <li><button style="text-align: left; width: 100%; border: 0px; cursor: pointer; background: var(--accent-tint); color: var(--accent-700); padding: 6px 10px; border-radius: 6px; font-size: 13.5px; font-weight: 600; font-family: var(--mono);">Quickstart</button></li>
          <li><button style="text-align: left; width: 100%; border: 0px; cursor: pointer; background: transparent; color: var(--ink-2); padding: 6px 10px; border-radius: 6px; font-size: 13.5px; font-weight: 400; font-family: var(--sans);">Core concepts</button></li>
        </ul>
      </div>
      <div style="margin-bottom: 22px;"><span class="kicker" style="display: block; padding: 0px 10px 8px;">API Reference</span>
        <ul class="col gap-1" style="list-style: none; padding: 0px; margin: 0px;">
          <li><button style="text-align: left; width: 100%; border: 0px; cursor: pointer; background: transparent; color: var(--ink-2); padding: 6px 10px; border-radius: 6px; font-size: 13.5px; font-weight: 400; font-family: var(--sans);">Authentication</button></li>
          <li><button style="text-align: left; width: 100%; border: 0px; cursor: pointer; background: transparent; color: var(--ink-2); padding: 6px 10px; border-radius: 6px; font-size: 13.5px; font-weight: 400; font-family: var(--sans);">Ingest a webhook</button></li>
          <li><button style="text-align: left; width: 100%; border: 0px; cursor: pointer; background: transparent; color: var(--ink-2); padding: 6px 10px; border-radius: 6px; font-size: 13.5px; font-weight: 400; font-family: var(--sans);">Email-in</button></li>
          <li><button style="text-align: left; width: 100%; border: 0px; cursor: pointer; background: transparent; color: var(--ink-2); padding: 6px 10px; border-radius: 6px; font-size: 13.5px; font-weight: 400; font-family: var(--sans);">List records</button></li>
        </ul>
      </div>
      <div style="margin-bottom: 22px;"><span class="kicker" style="display: block; padding: 0px 10px 8px;">CLI</span>
        <ul class="col gap-1" style="list-style: none; padding: 0px; margin: 0px;">
          <li><button style="text-align: left; width: 100%; border: 0px; cursor: pointer; background: transparent; color: var(--ink-2); padding: 6px 10px; border-radius: 6px; font-size: 13.5px; font-weight: 400; font-family: var(--sans);">Command reference</button></li>
          <li><button style="text-align: left; width: 100%; border: 0px; cursor: pointer; background: transparent; color: var(--ink-2); padding: 6px 10px; border-radius: 6px; font-size: 13.5px; font-weight: 400; font-family: var(--sans);">Markdown &amp; frontmatter</button></li>
        </ul>
      </div>
    </nav><!-- content -->
    <main class="scroll" style="overflow-y: auto; padding: 44px 56px 80px;">
      <div style="max-width: 720px; margin: 0px auto;"><span class="mono faint" style="font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;">Introduction</span>
        <h1 class="h1" style="margin-top: 10px; font-size: 38px;">Quickstart</h1>
        <p class="lead" style="margin-top: 12px;">Go from zero to your first synced Markdown file in about five minutes.</p>
        <hr class="rule" style="margin-top: 26px;"><!-- dynamic content per page -->
        <anonymous-stub></anonymous-stub><!-- prev / next -->
        <div class="row between" style="margin-top: 48px; gap: 14px;"><button></button><button></button></div>
      </div>
    </main><!-- on this page -->
    <aside class="scroll" style="padding: 44px 20px; overflow-y: auto; border-left-width: var(--line); border-left-style: var(--line); border-left-color: var(--line);"><span class="kicker" style="display: block; margin-bottom: 12px;">on this page</span>
      <div class="col gap-2"><span class="mono" style="font-size: 12px; color: var(--accent-700); padding-left: 10px; cursor: pointer; border-left-width: var(--accent); border-left-style: var(--accent); border-left-color: var(--accent);">Install the CLI</span><span class="mono" style="font-size: 12px; color: var(--ink-3); padding-left: 10px; cursor: pointer; border-left-width: var(--line); border-left-style: var(--line); border-left-color: var(--line);">Authenticate</span><span class="mono" style="font-size: 12px; color: var(--ink-3); padding-left: 10px; cursor: pointer; border-left-width: var(--line); border-left-style: var(--line); border-left-color: var(--line);">Point a source</span><span class="mono" style="font-size: 12px; color: var(--ink-3); padding-left: 10px; cursor: pointer; border-left-width: var(--line); border-left-style: var(--line); border-left-color: var(--line);">Sync</span></div>
      <div class="card" style="padding: 14px; margin-top: 28px;"><span class="mono faint" style="font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase;"> need a hand? </span>
        <p style="font-size: 13px; margin: 8px 0px 12px; line-height: 1.5;"> Drop into the community or open an issue. </p>
        <appbtn size="sm" block="true" icon="github" href="https://github.com/neonpixels-studio/markpost">github</appbtn>
      </div>
    </aside>
  </div>
</div>"
`;
