#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/            public-key encryption for .env files          /
#/       [how it works](https://dotenvx.com/encryption)     /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY_PRODUCTION="03f0a550fefabe8ab09217e09f1cea4e5fedff1f01c29b04fd7359ca757d53c992"

# .env.production
# Netlify PRODUCTION build. Decrypted at build time by DOTENV_PRIVATE_KEY_PRODUCTION
# (set in Netlify env, Builds scope). NUXT_* values bake into the server bundle.
#
# NOTE: seeded from the local .env because no separate Netlify prod values existed
# yet. Swap the marked values for real production ones before going live, e.g.:
#   npx dotenvx set NUXT_PUBLIC_APP_URL "https://<your-domain>" -f .env.production
#   npx dotenvx set STRIPE_SECRET_KEY "sk_live_..." -f .env.production

# Neon DB — point at the production Neon branch (currently the shared branch).
DATABASE_URL=encrypted:
NUXT_DATABASE_URL=encrypted:

