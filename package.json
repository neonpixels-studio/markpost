{
  "name": "markpost",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "TMPDIR=/tmp dotenvx run -f .env -- nuxt dev",
    "dev:test": "TMPDIR=/tmp nuxt dev",
    "build": "dotenvx run -f .env.production -- nuxt build",
    "build:dev": "dotenvx run -f .env.dev -- nuxt build",
    "preview": "dotenvx run -f .env.production -- nuxt preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:ci": "vitest run",
    "lint": "prettier --check . && eslint . && fallow audit",
    "lint:ci": "prettier --check . && eslint . && fallow audit --base origin/${BASE_BRANCH:-main}",
    "lint:fix": "prettier --write . && eslint . --fix && fallow fix --yes",
    "prepare": "husky",
    "db:generate": "dotenvx run -f .env -- drizzle-kit generate",
    "db:migrate": "dotenvx run -f .env -- drizzle-kit migrate",
    "db:check:production": "dotenvx run -f .env.production -- node scripts/check-migration-drift.ts",
    "db:check:snapshots": "node scripts/check-migration-snapshots.ts",
    "db:migrate:production": "dotenvx run -f .env.production -- drizzle-kit migrate",
    "db:push": "dotenvx run -f .env -- drizzle-kit push",
    "db:studio": "dotenvx run -f .env -- drizzle-kit studio",
    "pree2e": "nuxt prepare",
    "e2e": "dotenvx run -f .env.e2e -- playwright test",
    "e2e:headed": "dotenvx run -f .env.e2e -- playwright test --headed",
    "e2e:ui": "dotenvx run -f .env.e2e -- playwright test --ui",
    "e2e:debug": "dotenvx run -f .env.e2e -- playwright test --debug",
    "e2e:report": "playwright show-report e2e/report"
  },
  "dependencies": {
    "@clerk/backend": "^3.13.2",
    "@clerk/nuxt": "^2.6.23",
    "@neondatabase/serverless": "^1.1.0",
    "@pinia/nuxt": "^1.0.1",
    "@sentry/nuxt": "^10.68.0",
    "@types/turndown": "^5.0.6",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "nuxt": "^4.5.1",
    "pinia": "^4.0.2",
    "stripe": "^22.3.2",
    "turndown": "^7.2.4",
    "vue": "^3.5.40",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.14",
    "@dotenvx/dotenvx": "^2.19.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/ui": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "fallow": "^3.10.0",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "minimatch": "^10.2.5",
    "brace-expansion": "^5.0.9",
    "nanoid": "^3.3.17",
    "next": {
      "postcss": "^8.5.23",
      "sharp": "^0.35.3"
    }
  }
}
